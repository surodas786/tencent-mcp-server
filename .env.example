# Copy to .env. Placeholders only. Never put a system_admin key here: the adapter refuses it.

# --- Services (same for everyone on this deployment) ---
TENCENTDB_PANEL_URL=http://192.168.91.2:8125
TENCENTDB_KNOWLEDGE_URL=http://192.168.91.2:8424
TENCENTDB_SERVICE_ID=default

# --- This developer (stdio only) ---
# With TENCENTDB_MCP_TRANSPORT=http these three are ignored: each client sends its own in mcp-client/mcp.json.
# Issued per user in Memory Hub. Used for MemoryPanel; this is the only credential most developers need.
TENCENTDB_USER_KEY=<this-developer-user-key>
TENCENTDB_AGENT_ID=<this-developer-agent-id>
# The real user ID (usr-...). Find it with: npm run whoami
TENCENTDB_USER_ID=<verified-user-id>

# --- Team ---
TENCENTDB_TEAM_ID=<team-id>
# The wiki that holds published team decisions. Required for 'team_shared' saves.
TENCENTDB_DECISIONS_WIKI_ID=<wiki-id>

# --- Remote adapter ---
# 'stdio' (default) or 'http'. Set to http on the host that serves remote MCP clients.
# TENCENTDB_MCP_TRANSPORT=http
# Address and port to listen on. Defaults: 0.0.0.0 and 8787.
# TENCENTDB_MCP_HOST=0.0.0.0
# TENCENTDB_MCP_PORT=8787

# --- Optional ---
# Neither of the next two exists in Memory Hub, and both can stay unset.
# A label of your choice for this project, shown in context results. Default: 'default'.
# TENCENTDB_PROJECT_ID=
# The ID of an ordinary agent to treat as the team's shared agent. Default: none.
# TENCENTDB_SHARED_AGENT_ID=
# JSON file of project profiles, for more than one project. See docs/PROJECTS.example.json.
# TENCENTDB_PROJECTS_FILE=
# Approximate token budget for get_development_context. Default 8000.
# TENCENTDB_MAX_CONTEXT_TOKENS=8000
# Seconds to reuse an identical context request. Default 300; 0 disables.
# TENCENTDB_CONTEXT_CACHE_SECONDS=300

# --- Legacy direct MemoryCore access (not recommended) ---
# Needs the shared gateway token, which lets its holder claim any identity.
# TENCENTDB_MEMORY_ACCESS=core
# TENCENTDB_MEMORY_URL=http://192.168.91.2:8420
# TENCENTDB_API_KEY=<shared-gateway-token>
